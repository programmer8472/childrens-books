# Copy to .env before first run:  cp .env.example .env
# All config flows through env vars (no literals in code).

# --- Database ---
DATABASE_URL=postgresql+psycopg://books:books@localhost:5432/books

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ("local" stands in for S3 in dev) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
