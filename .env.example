# Copy to .env before first run:  cp .env.example .env
# All config flows through env vars (no literals in code).

# --- Database ---
DATABASE_URL=postgresql+psycopg://books:books@localhost:5432/books

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Providers ---
# Set LLM_PROVIDER=deepseek (and DEEPSEEK_API_KEY) for real generation.
# Defaults to "fake" so local dev and tests work without an API key.
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=sk-...

# IMAGE_PROVIDER=placeholder generates labeled gray rectangles at correct spread
# dimensions while the real image API key is not yet available.
# Swap to the real provider name (e.g. "leonardo") and re-run GENERATING_IMAGES
# to replace all placeholders — no code changes required.
IMAGE_PROVIDER=fake

# --- Storage ("local" stands in for S3 in dev) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
