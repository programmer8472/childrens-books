# Copy to .env.local and adjust as needed.
# HTTP API base URL (used server-side for rewrites and client-side for direct fetches)
NEXT_PUBLIC_API_URL=http://localhost:8001

# WebSocket base URL
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Server-side rewrite target (used in next.config.ts)
API_URL=http://localhost:8001
